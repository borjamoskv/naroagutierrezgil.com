---
// src/components/games/WgpuCanvas.astro
// Este componente Astro inicializa el canvas y carga el módulo WASM en el cliente.
---
<div class="wgpu-container w-full h-screen bg-black flex items-center justify-center">
  <canvas id="wgpu-canvas" class="w-full h-full object-cover"></canvas>
  <div id="loading-indicator" class="absolute text-white font-mono opacity-50">
    [INIT C5-REAL WEBGPU...]
  </div>
</div>

<script>
  // Inicialización de WASM del lado del cliente
  import init, { init_engine } from '../../wasm_core/pkg/wasm_core.js';

  async function bootWebGpu() {
    try {
      await init();
      const canvas = document.getElementById('wgpu-canvas');
      const engine = init_engine(canvas.clientWidth, canvas.clientHeight);
      
      const loader = document.getElementById('loading-indicator');
      if (loader) loader.style.display = 'none';

      function renderLoop() {
        engine.update();
        engine.render();
        requestAnimationFrame(renderLoop);
      }
      
      requestAnimationFrame(renderLoop);
    } catch (e) {
      console.error("[C5-REAL ERROR] WebGPU no inicializado:", e);
    }
  }

  // Ejecutar solo en el navegador
  if (typeof window !== 'undefined') {
    bootWebGpu();
  }
</script>
