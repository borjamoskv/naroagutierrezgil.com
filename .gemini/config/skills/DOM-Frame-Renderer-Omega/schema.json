  "properties": {
    "intent": { "type": "string" },
    "causal_parent": { "type": "string" },
    "requested_by": { "type": "string" },
    "shard_range": { "type": "array", "items": { "type": "integer" } },
    "lowpass_locked": { "type": "boolean" },
    "capacity": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
