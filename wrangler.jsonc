{
  "name": "naroart-kintsugi-ledger",
  "main": "src/agents/index.ts",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "EntropicCanvasAgent", "class_name": "EntropicCanvasAgent" }
